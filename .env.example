# Copy to .env and fill in. Never commit .env.
# Start with DRY_RUN=true: the trader logs what it WOULD do, supply logs what it WOULD bridge/withdraw.
# Keep comments on their own lines: python-dotenv treats `KEY=  # text` as the value "# text".

# ---- run mode ----
# false = real orders, swaps, bridges, withdrawals. Every entry point reads this.
DRY_RUN=true
# Relative paths resolve against the repo directory. `touch .STOP` halts the trader;
# a CUM_LOSS halt writes a reason into it; `echo bridge > .STOP` is the marker the bridge watchdog may lift.
KILL_SWITCH_FILE=.STOP
POLL_INTERVAL_SEC=10

# ---- SafeTrade (CEX) ----
# Key permissions: trade. Add withdraw ONLY if you run supply.py (it withdraws to WHITELISTED beneficiaries only).
SAFETRADE_API_KEY=
SAFETRADE_API_SECRET=
SAFETRADE_BASE_URL=https://safe.trade/api/v2
SAFETRADE_MARKET=prlusdt
SAFETRADE_TAKER_FEE_BPS=20
CEX_AMOUNT_PRECISION=4

# ---- Ethereum wallet / RPC ----
# Trading wallet private key (hex). This file must be chmod 600.
EVM_PRIVATE_KEY=
EVM_WALLET_ADDRESS=0xYOUR_EVM_WALLET
EVM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>
EVM_RPC_URL_FALLBACK=
# Optional comma-separated public read-only RPCs used when the primary is rate-limited.
# Empty = built-in default list (publicnode, drpc).
EVM_RPC_PUBLIC=
# Optional private tx relay for swaps. Empty = built-in default https://rpc.flashbots.net/fast.
PRIVATE_TX_RPC_URL=

# ---- contracts (Ethereum mainnet) ----
WPRL_ADDRESS=0x07696DcaB55E62cfef953666b29Fe1970518cB00
USDT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7
USDC_ADDRESS=0xA0b86991c6218b36c1D19D4a2e9Eb0cE3606eB48
WETH_ADDRESS=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
UNISWAP_ROUTER=0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45
WPRL_POOL_ADDRESS=0x89a67c6DEE35DB9815dA2fb9191F0998A8B37C39
# The WPRL/USDT V3 pool is the 1% tier.
WPRL_POOL_FEE_TIER=10000
WPRL_QUOTE_TOKEN=USDT
DEX_POOL_FEE_BPS=100

# ---- strategy ----
# Minimum net edge (after both fees and gas) to fire.
MIN_GAP_BPS=200
REBALANCE_GAP_BPS=50
# Skip shots whose expected profit is below this (also re-applied after HARD_MAX_TRADE_USD shrinks a shot).
MIN_TRADE_PNL_USD=1
# BASE shot size. NOT a ceiling: adaptive sizing scales a shot UP to where the last token
# still clears MIN_GAP_BPS against the live book and pool.
MAX_TRADE_USD=250
# Absolute per-shot USD cap applied after adaptive sizing; 0 = no cap. A cap that rounds
# to zero quantity makes the trader skip, never trade uncapped.
HARD_MAX_TRADE_USD=0
GAS_BUFFER_USD=5
SLIPPAGE_TOLERANCE_BPS=100
# Advisory only (arb.py skew warnings); supply.py targets are constants in supply.py.
SHARE_TARGET_PCT=55
SHARE_DEADBAND_PCT=10
BRIDGE_SKEW_HIGH_PCT=70
BRIDGE_SKEW_LOW_PCT=30
BRIDGE_ADVISORY_INTERVAL_SEC=3600
BRIDGE_INFLIGHT_WINDOW_SEC=5400
# PearlBridge reverse fee: max(0.5%, BRIDGE_MIN_PRL).
BRIDGE_FEE_BPS_PRL_TO_WPRL=50
BRIDGE_FEE_BPS_WPRL_TO_PRL=0
BRIDGE_MIN_PRL=4
MIN_PRL_INVENTORY=2000
MAX_PRL_INVENTORY=20000
MIN_WPRL_INVENTORY=2000
MAX_WPRL_INVENTORY=20000
MIN_USDT_INVENTORY=200
MIN_USDC_INVENTORY=200

# ---- exchange routing identities (supply.py; required when supply runs live, may be blank in DRY_RUN) ----
# Beneficiary ids = numeric ids of your WHITELISTED withdrawal addresses on SafeTrade (Account -> Beneficiaries).
# PRL beneficiary = the Pearl deposit address PearlBridge bound to EVM_WALLET_ADDRESS.
SAFETRADE_PRL_BRIDGE_BENEFICIARY_ID=
# USDT (ERC20) beneficiary = EVM_WALLET_ADDRESS.
SAFETRADE_USDT_BENEFICIARY_ID=
# Your SafeTrade native PRL deposit address (prl1...), target of WPRL->PRL bridges.
SAFETRADE_PRL_DEPOSIT_ADDR=
# Your SafeTrade ERC20 USDT deposit address (0x...), target of EVM->CEX top-ups.
SAFETRADE_USDT_DEPOSIT_ADDR=

# ---- alerts (WeCom / 企业微信, optional; unset = log only) ----
WECHAT_CORP_ID=
WECHAT_OPS_SECRET=
WECHAT_OPS_AGENT_ID=
WECHAT_ADMIN_USER_ID=
